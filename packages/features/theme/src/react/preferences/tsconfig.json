{
  "extends": "@repo/foundation-typescript-config/react-library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2025",
    "lib": ["es2025", "dom", "DOM.Iterable", "DOM.AsyncIterable"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["node_modules", "coverage", "dist", ".turbo"]
}
