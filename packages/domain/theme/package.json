{
  "name": "@repo/domain-theme",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "dependencies": {
    "@repo/domain-preferences": "workspace:*",
    "culori": "^4.0.1",
    "zod": "^4.5.4"
  },
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:run": "vitest run --coverage",
    "test": "vitest run"
  },
  "devDependencies": {
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@repo/foundation-typescript-config": "workspace:*",
    "@repo/foundation-vitest-config": "workspace:*",
    "@repo/foundation-vitest-utils": "workspace:*",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@types/culori": "^4.0.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./color": "./src/color/index.ts",
    "./appearance": "./src/appearance/index.ts",
    "./density": "./src/density/index.ts",
    "./theme": "./src/theme/index.ts",
    "./compiler": "./src/compiler/index.ts",
    "./colors": "./src/color/index.ts",
    "./model": "./src/color/model.ts",
    "./resolution": "./src/appearance/index.ts",
    "./core/resolution": "./src/appearance/index.ts",
    "./constants": "./src/constants.ts"
  }
}
