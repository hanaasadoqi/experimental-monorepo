{
  "name": "@workspace/domain-theme",
  "version": "0.1.0",
  "description": "Pure theme domain kernel—types, schemas, color science, and compilation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "import": "./dist/color/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "culori": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@types/node": "^20.12.0"
  }
}
