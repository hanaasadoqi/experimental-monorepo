{
  "name": "@repo/domain-theme",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "dependencies": {
    "@repo/features-preferences": "workspace:*",
    "culori": "^4.0.1",
    "zod": "^4.5.4"
  },
  "scripts": {
