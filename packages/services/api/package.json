{
  "name": "@repo/services-api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:run": "vitest run --coverage",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "@faker-js/faker": "^9.0.0"
  },
  "devDependencies": {
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@repo/foundation-typescript-config": "workspace:*",
    "@repo/foundation-vitest-config": "workspace:*",
    "@repo/foundation-vitest-utils": "workspace:*",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^7.9.0",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  },
  "exports": {
    "./client": "./src/client/index.ts",
    "./types": "./src/types/index.ts",
    "./fixtures": "./src/fixtures/index.ts"
