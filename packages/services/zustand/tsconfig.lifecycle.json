{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/persist/**/*.ts",
    "src/hydration/**/*.ts",
    "src/testing/**/*.ts"
  ]
}
