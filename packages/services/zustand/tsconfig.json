{
  "extends": "@repo/foundation-typescript-config/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "@types/node", "**/*.d.ts", "**/*.d.tsx"],
  "exclude": ["node_modules", "dist", "coverage"]
}
