{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "target": "es2025",
    "types": ["vitest/globals"],
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.test.js", "src/**/*.test.jsx"],
  "exclude": ["node_modules", "dist", "coverage"]
}
