{
  "name": "@repo/shared-utils",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run --coverage"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@repo/foundation-typescript-config": "workspace:*",
    "@repo/foundation-vitest-config": "workspace:*",
    "@repo/foundation-vitest-utils": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  },
  "exports": {
    "./classnames": "./src/classnames.ts",
    ".": "./src//index.ts",
    "./*": "./src/*"
  }
}
