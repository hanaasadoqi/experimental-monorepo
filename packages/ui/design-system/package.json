{
  "name": "@repo/ui-design-system",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "check-types": "tsc --noEmit",
    "test:run": "vitest run --coverage",
    "test": "vitest run"
  },
  "exports": {
    "./index.css": "./src/styles/index.css"
  },
  "devDependencies": {
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@repo/foundation-typescript-config": "workspace:*",
    "@repo/foundation-vitest-config": "workspace:*",
    "@repo/foundation-vitest-utils": "workspace:*",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.4.0",
    "culori": "^4.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
