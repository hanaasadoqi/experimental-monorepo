{
  "name": "@repo/ui-design-system",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate-css.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:run": "vitest run --coverage",
    "test": "vitest run"
  },
  "exports": {
    "./index.css": "./src/styles/index.css",
    "./tokens": "./src/tokens/index.ts",
    "./colors": "./src/tokens/colors.ts",
    "./typography": "./src/tokens/typography.ts"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@repo/foundation-typescript-config": "workspace:*",
    "@repo/foundation-vitest-config": "workspace:*",
    "@repo/foundation-vitest-utils": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^7.9.0",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^7.9.0",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
