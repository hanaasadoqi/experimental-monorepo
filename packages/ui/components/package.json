{
  "name": "@repo/ui-components",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#base/lib/*": "./src/base/lib/*.ts"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:run": "vitest run --coverage",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@repo/ui-design-system": "workspace:*",
    "@repo/shared-utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.15",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@repo/foundation-typescript-config": "workspace:*",
    "@repo/foundation-vitest-config": "workspace:*",
    "@repo/foundation-vitest-utils": "workspace:*",
    "eslint": "^9.39.5",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.2.0",
    "jsdom": "^27.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^7.9.0",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/components/*.tsx",
    "./theme.css": "./src/base/styles/shadcn.css",
    "./lib/*": "./src/lib/*.ts",
    "./base": "./src/base/ui/index.ts",
    "./base/*": "./src/base/ui/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
