{
  "extends": "@repo/foundation-typescript-config/react-library.json",
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025", "dom", "DOM.Iterable", "DOM.AsyncIterable"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@repo/ui-components/*": ["./src/*"]
    },
    "types": ["react", "react-dom", "node"]
  },
  "include": ["src", "@types/node", "@types/react", "@types/react-dom", "**/*.d.ts", "**/*.d.tsx"],
  "exclude": ["node_modules", "dist"]
}
