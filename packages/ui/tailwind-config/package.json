{
  "name": "@repo/ui-tailwind-config",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "eslint",
    "format": "prettier . --write \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "format:check": "prettier . --check \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "check-types": "tsc --noEmit",
    "test:run": "vitest run --coverage",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.css",
    "./index.css": "./src/theme.css",
    "./postcss.config": "./postcss.config.mjs",
    "./global.css": "./src/theme.css"
  },
  "dependencies": {
    "@repo/ui-design-system": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@repo/foundation-typescript-config": "workspace:*",
    "@repo/foundation-vitest-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
