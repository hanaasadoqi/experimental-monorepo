{
  "name": "@repo/ui-tailwind-config",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "eslint",
    "format": "prettier . --write \"**/*.{mjs,ts,css,json,js}\"",
    "format:check": "prettier . --check \"**/*.{mjs,ts,css,json,js}\""
  },
  "exports": {
    ".": "./src/index.css",
    "./index.css": "./src/theme.css",
    "./postcss.config": "./postcss.config.mjs",
    "./global.css": "./src/theme.css"
  },
  "dependencies": {
    "@repo/ui-design-system": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6"
  }
}
