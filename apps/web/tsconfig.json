{
  "extends": "@repo/foundation-typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@repo/ui-components/base": ["../../packages/ui/components/src/base/index.ts"],
      "@repo/ui-components/base/*": ["../../packages/ui/components/src/base/*.tsx"],
      "@repo/ui-components/lib/*": ["../../packages/ui/components/src/lib/*.ts"],
      "@repo/ui-components/hooks/*": ["../../packages/ui/components/src/hooks/*.ts"],
      "@repo/ui-components/globals.css": ["../../packages/ui/components/src/styles/globals.css"],
      "@repo/ui-components/*": ["../../packages/ui/components/src/components/*.tsx"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src",
    "next-env.d.ts",
    "next.config.ts",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".turbo"]
}
