{
  "extends": "@repo/foundation-typescript-config/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "@types/**/*.d.ts",
  ],
  "exclude": ["node_modules", ".next", ".turbo", "src/components/quarantine"]
}
